# fleet approve-cr (task_913) — CRUX CriticService Ship-It endpoint config.
#
# This is a LOCAL, deploy-injected resource. Copy it to $XDG_CONFIG_HOME/fleet/crux.toml
# (fallback ~/.config/fleet/crux.toml) and fill in this host's real values. The public repo
# carries ONLY this placeholder shape — the real internal CriticService host + target header
# must never be committed (public-repo-safe, same pattern as host-services.toml.example).

# The CriticService SSO front-door URL (Midway / human identity) that casts the Ship-It vote.
# The CRUX API refuses service principals — the vote casts as the authenticated human.
endpoint = "https://<critic-service-sso-host>"

# The Coral X-Amz-Target for the approve operation.
amz_target = "com.amazon.critic.CriticService.ApproveReviewRevision"

# Optional: path to the Midway cookie the cast authenticates with. Defaults to ~/.midway/cookie.
# A stale cookie is detected at cast time (the SSO front door redirects to login) and the command
# tells you to run `mwinit -s` rather than failing silently.
# midway_cookie = "/home/<user>/.midway/cookie"
